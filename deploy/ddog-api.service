[Unit]
Description=DDOG dashboard API
After=network.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ddog-dashboard
EnvironmentFile=/opt/ddog-dashboard/.env
ExecStart=/opt/ddog-dashboard/venv/bin/python /opt/ddog-dashboard/deploy/ddog_api.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
